{
  "name": "kamado",
  "version": "1.23.0",
  "description": "L application universelle de reference pour les utilisateurs de kamados",
  "private": true,
  "scripts": {
    "test": "node --test 'tests/*.test.js'",
    "extract": "node scripts/extract-data.js",
    "editorial:generate": "node scripts/generate-editorial-pages.js",
    "audit:data": "node scripts/audit-data.js",
    "audit:expert": "node scripts/audit-kamado-expert.js",
    "audit:chef": "node scripts/audit-chef.js",
    "audit:quality": "node scripts/audit-recipe-quality.js",
    "audit:performance": "node scripts/audit-performance-budget.js",
    "audit:editorial": "node scripts/audit-editorial.js",
    "audit:sommelier": "node scripts/audit-sommelier.js",
    "audit": "node scripts/audit-data.js && node scripts/audit-kamado-expert.js && node scripts/audit-chef.js && node scripts/audit-sommelier.js && node scripts/audit-editorial.js && node scripts/audit-performance-budget.js",
    "build:mobile": "node scripts/prepare-mobile.js && node scripts/generate-native-assets.js",
    "mobile:assets": "node scripts/generate-native-assets.js",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:open:ios": "npx cap open ios",
    "mobile:open:android": "npx cap open android"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/ios": "^6.0.0"
  }
}
